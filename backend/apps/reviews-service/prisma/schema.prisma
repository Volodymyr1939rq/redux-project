
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url=env("POSTGRES_URI")
  directUrl = env("REVIEWS_DIRECT_URL")
}

model Review{
  id            String   @id @default(cuid())
  productId     String
  userId        String?

  rating        Int
  text          String
  advantages    String?
  disadvantages String?
  videoUrl      String[]
  imageUrl      String[]
  authorName    String
  authorEmail   String
  notifyOrReply Boolean @default(false)
  likes         Int  @default(0)

  replyToId     String?
  replyTo       Review? @relation("ReviewReplies",fields: [replyToId],references: [id])
  replies       Review[] @relation("ReviewReplies")

  createdAt     DateTime @default(now())
}