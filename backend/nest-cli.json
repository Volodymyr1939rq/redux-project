{
  "monorepo": true,
  "root": "apps/main-api",
  "sourceRoot": "apps/main-api/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/main-api/tsconfig.app.json"
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "main": {
      "type": "application",
      "root": "apps/main-api",
      "entryFile": "main",
      "sourceRoot": "apps/main-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/main-api/tsconfig.app.json"
      }
    },
    "reviews-service": {
      "type": "application",
      "root": "apps/reviews-service",
      "entryFile": "main",
      "sourceRoot": "apps/reviews-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reviews-service/tsconfig.app.json"
      }
    }
  }
}